<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- O AAR da Rede declara android:label="@string/app_name" no <application>, e a mesclagem falha no
         conflito com o rótulo do app. O tools:replace mantém o rótulo do manifest principal. -->
    <application
        android:label="example"
        tools:replace="android:label" />
</manifest>
